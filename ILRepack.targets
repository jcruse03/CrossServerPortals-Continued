<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="MergeDependencies" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <InputAssemblies Include="$(TargetPath)" />
      <InputAssemblies Include="$(TargetDir)ServerSync.dll" />
    </ItemGroup>
    <ILRepack Parallel="true"
              DebugInfo="true"
              Internalize="true"
              InputAssemblies="@(InputAssemblies)"
              OutputFile="$(TargetDir)$(AssemblyName).merged.dll"
              TargetKind="SameAsPrimaryAssembly"
              LibraryPath="$(TargetDir);$(GamePath)/BepInEx/core;$(GamePath)/valheim_Data/Managed" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).merged.dll" DestinationFiles="$(TargetPath)" />
    <Delete Files="$(TargetDir)$(AssemblyName).merged.dll;$(TargetDir)ServerSync.dll" />
  </Target>

  <Target Name="Package" DependsOnTargets="Build;MergeDependencies" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageStage>$(MSBuildProjectDirectory)/artifacts/package/$(AssemblyName)-$(Version)</PackageStage>
      <PackageFile>$(MSBuildProjectDirectory)/artifacts/$(AssemblyName)-v$(Version).zip</PackageFile>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStage)" />
    <MakeDir Directories="$(PackageStage)" />
    <ItemGroup>
      <PackageFiles Include="$(TargetPath)" />
      <PackageFiles Include="manifest.json;README.md;CHANGELOG.md;icon.png" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(PackageStage)" />
    <Delete Files="$(PackageFile)" />
    <ZipDirectory SourceDirectory="$(PackageStage)" DestinationFile="$(PackageFile)" />
    <Message Importance="high" Text="Created $(PackageFile)" />
  </Target>
</Project>
