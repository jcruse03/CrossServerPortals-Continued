<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ValheimCrossServerPortals</AssemblyName>
    <RootNamespace>Lunarbin.Valheim.CrossServerPortals</RootNamespace>
    <Description>Community-maintained Valheim Cross Server Portals continuation</Description>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release</Configurations>
    <GamePath Condition="'$(GamePath)' == ''">$(VALHEIM_GAME_PATH)</GamePath>
    <OutputPath>artifacts/bin/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <Target Name="ValidateGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GamePath)' == ''" Text="Set VALHEIM_GAME_PATH or pass /p:GamePath=/path/to/Valheim." />
    <Error Condition="!Exists('$(GamePath)/valheim_Data/Managed/assembly_valheim.dll')" Text="Valheim assemblies were not found below GamePath '$(GamePath)'." />
  </Target>

  <Target Name="GenerateVersionSource" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <GeneratedPath>$(IntermediateOutputPath)GeneratedVersion.cs</GeneratedPath>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(GeneratedPath)" Lines="namespace $(RootNamespace) { internal static class BuildInfo { public const string Version = &quot;$(Version)&quot;%3B } }" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(GeneratedPath)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.40" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Reference Include="0Harmony" HintPath="$(GamePath)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(GamePath)/valheim_Data/Managed/assembly_valheim.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(GamePath)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="ServerSync" HintPath="Libs/ServerSync.dll" Private="true" />
    <Reference Include="Splatform" HintPath="$(GamePath)/valheim_Data/Managed/Splatform.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GamePath)/valheim_Data/Managed/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GamePath)/valheim_Data/Managed/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(GamePath)/valheim_Data/Managed/UnityEngine.ParticleSystemModule.dll" Private="false" />
  </ItemGroup>

</Project>
